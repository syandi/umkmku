{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // Kode aplikasi memakai tipe runtime Workers. Test memakai tipe Bun (test/tsconfig.json)
  // agar kedua set tipe global tidak saling bertabrakan.
  "include": ["src", "worker-configuration.d.ts"]
}
